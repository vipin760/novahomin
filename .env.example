# Optional. Set the confirmed production origin before building to enable canonical URLs and sitemap entries.
# SITE_URL=https://your-confirmed-domain.example

# Optional. Set the confirmed enquiry address before building to enable the email composer.
# CONTACT_EMAIL=your-confirmed-address@example.com

# Admin login at /admin (required for the admin section).
USER_NAME=your-admin-username
USER_PASS=use-a-long-unique-password
# Random string, 16+ characters, used to sign admin sessions. Generate: openssl rand -hex 32
SESSION_SECRET=replace-with-random-hex

# Optional. Folder for stored enquiries and newsletter sign-ups (default ./.data). Needs persistent disk.
# DATA_DIR=/var/lib/novahomin

# MongoDB (enquiries, subscribers, blog, portfolio, media, SMTP settings).
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=novahomin

# Cloudinary (media library uploads). Find these in the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
